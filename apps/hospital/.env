# Not secret. Override in .env.local (git-ignored) or the shell.
# Mocks first (docs/mock-data.md). Set to false to call the real backend.
NEXT_PUBLIC_USE_MOCKS=true
# Gateway. Dev default from docs/api-contract.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Notification service SockJS endpoint (decisions-and-gaps G7).
NEXT_PUBLIC_WS_URL=http://localhost:8084/ws
